# Sudowork WebUI 环境变量示例（复制为 .env 使用；.env 不入库）

# PostgreSQL 连接（WebUI 自有库，仅存 Web Session/偏好/会话锁）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sudowork_webui

# Web Session Cookie token 的 HMAC 密钥（生成：openssl rand -hex 32）
SESSION_HMAC_KEY=

# Moss access/refresh token 的 AES-256-GCM 密钥（32 字节，生成：openssl rand -base64 32）
TOKEN_AES_KEY=

# 对外可访问的完整 Origin（生产必填 HTTPS，例如 https://webui.example.com）
PUBLIC_ORIGIN=http://localhost:26808

# Moss 服务地址（只读访问，不由 WebUI 部署）
#
# ⚠️ 这两个的 host 必须与 **Moss 自己 server.json 里的 `server.publicBaseUrl`** 一致。
# Moss 建会话/resume 返回的 ws_url 是由 publicBaseUrl 生成的，而 WebUI 不信任该地址：
# host 不等就拒绝连接（packages/moss-client 的 validateMossWsUrl），表现为**每次发消息
# 都失败、而 HTTP 面全部正常**（agents/skills/会话列表都能加载），Moss 侧也不会有任何
# 日志——因为连接在建立之前就被拒了。原因只会出现在 WebUI 的服务端日志里。
# 所以 Moss 若对外宣告域名（publicBaseUrl=https://moss.example.com），这里就必须填域名，
# 填它的 IP:端口一定不通。两者本身也必须同 host（启动时校验）。
MOSS_BASE_URL=http://10.0.1.79:43127
MOSS_WS_BASE_URL=ws://10.0.1.79:43127

# 登录页允许用户选择的额外 Moss Origin，逗号分隔。默认仅允许 MOSS_BASE_URL。
# 必须由管理员配置，不能使用通配符；服务端会拒绝列表外地址以避免 SSRF 和凭证钓鱼。
MOSS_ALLOWED_ORIGINS=

# CSP 允许的外部图片 Origin，逗号分隔；留空时仅允许同源与 data: 图片
CSP_IMG_SRC_ORIGINS=https://sudowork-hub-1309794936.cos.ap-beijing.myqcloud.com,https://sudoworkhub-1309794936.cos.ap-beijing.myqcloud.com

# 服务端口（开发 26809，生产 26808；生产经外部 HTTPS 反向代理）
PORT=26809
