        "./src/worker/*"
      ],
      "@sudowork/common/*": [
        "../../packages/common/src/*"
      ],
      "@sudowork/host-bridge/*": [
        "../../packages/host-bridge/src/*"
      ],
      "@sudowork/host-bridge": [
        "../../packages/host-bridge/src/index.ts"
      ],
      "@common": [
        "./src/common/index.ts"
      ],
