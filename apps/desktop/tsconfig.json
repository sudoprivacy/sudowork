{
  "compilerOptions": {
    "target": "ES6",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "ScriptHost"
    ],
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "jsx": "react",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
