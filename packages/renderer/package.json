    "@monaco-editor/react": "^4.7.0",
    "@office-ai/platform": "^0.3.16",
    "@sudowork/common": "workspace:*",
    "@sudowork/host-bridge": "workspace:*",
    "@uiw/react-codemirror": "^4.25.2",
    "@xterm/addon-fit": "^0.11.0",
    "ahooks": "^3.9.7",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.20",
    "diff": "^8.0.3",
    "diff2html": "^3.4.55",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "eventemitter3": "^5.0.1",
    "i18next": "^23.7.16",
    "katex": "^0.18.7",
