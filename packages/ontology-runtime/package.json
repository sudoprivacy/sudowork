{
  "name": "@sudowork/ontology-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sudowork/sudograph-runtime": "workspace:*",
    "@sudowork/ontology-common": "workspace:*",
    "@sudowork/ontology-engine": "workspace:*",
    "basic-ftp": "^6.2.1",
    "kafkajs": "^2.2.4",
    "mysql2": "^3.24.4",
    "mssql": "^12.7.2",
    "oracledb": "^7.0.1",
    "pg": "^8.22.0",
    "ssh2-sftp-client": "^12.1.1",
    "@aws-sdk/client-s3": "^3.1134.0",
    "csv-parse": "^7.0.2",
    "jszip": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/mssql": "^12.3.0",
    "@types/oracledb": "^7.0.3",
    "@types/ssh2-sftp-client": "^9.0.5"
  }
}
