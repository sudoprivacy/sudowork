          "const": "NativeOutputVerification",
          "default": "NativeOutputVerification",
          "title": "Kind",
          "type": "string"
        },
        "policy": {
          "const": "native-text-completion-v1",
          "default": "native-text-completion-v1",
          "title": "Policy",
          "type": "string"
        },
        "profile_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
