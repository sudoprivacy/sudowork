                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "source_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "version_evidence": {
                  "enum": [
                    "source_snapshot_only",
                    "provider_revision_fenced"
