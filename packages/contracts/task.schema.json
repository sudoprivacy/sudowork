{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudo.dev/experimental/task/v1alpha1",
  "$defs": {
    "SubmitTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "task.sudo.dev/v1alpha1"
        },
        "kind": {
          "const": "SubmitTask"
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "catalog_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            },
            "requested_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "requested_channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "catalog_id"
          ]
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "request_source": {
          "enum": [
            "interactive",
            "api"
          ]
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instruction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "parameters": {
              "type": "object",
              "maxProperties": 0
            },
            "resource_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "maxProperties": 20
              },
              "maxItems": 8
            }
          },
          "required": [
            "instruction",
            "resource_refs"
          ]
        },
        "workspace_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "maxProperties": 20
          },
          "maxItems": 8
        },
        "requested_mode": {
          "enum": [
            "auto",
            "local",
            "cloud",
            "private"
          ]
        },
        "data_classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "maxItems": 20
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idempotency_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120000
            },
            "deadline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "max_cost_units": {
              "type": "number",
              "minimum": 0
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "idempotency_key"
          ]
        },
        "output_contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_ref": {
              "type": "object",
              "maxProperties": 20
            },
            "artifact_types": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 20
            },
            "rubric_ref": {
              "type": "object",
              "maxProperties": 20
            }
          },
          "required": []
        },
        "parent_task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "supersedes_task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        }
      },
      "required": [
        "api_version",
        "kind",
        "agent",
        "request_source",
        "input",
        "workspace_refs",
        "requested_mode",
        "data_classification",
        "required_capabilities",
        "constraints"
      ]
    },
