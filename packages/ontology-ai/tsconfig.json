{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@sudowork/ontology-common": ["../ontology-common/src/index.ts"],
      "@sudowork/ontology-common/*": ["../ontology-common/src/*"],
      "@sudowork/host-bridge": ["../host-bridge/src/index.ts"],
      "@sudowork/host-bridge/*": ["../host-bridge/src/*"]
    }
  },
  "include": ["src"]
}
