{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@sudowork/ontology-common": ["../ontology-common/dist/index.d.ts"],
      "@sudowork/ontology-common/*": ["../ontology-common/dist/*.d.ts"]
    }
  },
  "include": ["src"]
}
