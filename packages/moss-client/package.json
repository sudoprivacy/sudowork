{
  "name": "@sudowork/moss-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agents": {
      "bun": "./src/MossAgentClient.ts",
      "types": "./dist/MossAgentClient.d.ts",
      "default": "./dist/MossAgentClient.js"
    },
    "./external-providers": {
      "bun": "./src/MossExternalProviderClient.ts",
      "types": "./dist/MossExternalProviderClient.d.ts",
      "default": "./dist/MossExternalProviderClient.js"
    },
    "./hosted-tasks": {
      "bun": "./src/MossHostedTaskClient.ts",
      "types": "./dist/MossHostedTaskClient.d.ts",
      "default": "./dist/MossHostedTaskClient.js"
    },
    "./input-delivery": {
      "bun": "./src/InputDeliveryClient.ts",
      "types": "./dist/InputDeliveryClient.d.ts",
      "default": "./dist/InputDeliveryClient.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sudowork/common": "workspace:*",
    "@sudowork/contracts": "workspace:*",
    "ws": "8.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
